rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Domain Validators (PILLAR 2)
    // ===============================================================

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'xp', 'createdAt']) &&
             data.keys().size() <= 30 && 
             data.uid is string && data.uid.size() > 0 && data.uid.size() < 100 &&
             data.email is string && data.email.size() < 150 &&
             data.xp is number && data.xp >= 0 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('country' in data) || (data.country is string && data.country.size() <= 100)) &&
             (!('welcomeWatched' in data) || (data.welcomeWatched is bool)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
             (!('completedPages' in data) || (data.completedPages is list && data.completedPages.size() <= 1000)) &&
             (!('completedModules' in data) || (data.completedModules is list && data.completedModules.size() <= 500)) &&
             (!('quizStates' in data) || (data.quizStates is string && data.quizStates.size() <= 50000));
    }

    // ===============================================================
    // Collection: Users
    // ===============================================================
    
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidUser(incoming());
    }

    match /public_profiles/{userId} {
      allow read: if true; 
      allow write: if isOwner(userId);
    }
  }
}
